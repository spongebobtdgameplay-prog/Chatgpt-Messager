{
  "manifest_version": 3,
  "name": "ChatGPT Messenger v12",
  "version": "12.1.0",
  "description": "Send prompts through your signed-in ChatGPT tab and keep a local message history.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  }
}
