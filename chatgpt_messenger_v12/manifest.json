{
  "manifest_version": 3,
  "name": "ChatGPT Messenger v12",
  "version": "12.0.1",
  "description": "Send messages through your signed-in ChatGPT tab.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  }
}
