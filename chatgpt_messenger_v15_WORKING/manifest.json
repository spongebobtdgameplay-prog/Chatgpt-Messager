{
  "manifest_version": 3,
  "name": "ChatGPT Messenger v15 WORKING",
  "version": "15.0.0",
  "description": "A persistent extension window for sending messages to your signed-in ChatGPT conversation.",
  "action": {
    "default_title": "Open ChatGPT Messenger v15 WORKING"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "windows",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://ab.chatgpt.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  }
}