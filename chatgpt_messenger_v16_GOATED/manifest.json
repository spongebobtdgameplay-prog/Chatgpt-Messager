{
  "manifest_version": 3,
  "name": "ChatGPT Messenger v16 GOATED",
  "version": "16.0.0",
  "description": "A persistent ChatGPT Messenger window with an intercepted-message prefix and conversation continuity.",
  "action": {
    "default_title": "Open ChatGPT Messenger v16 GOATED"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://ab.chatgpt.com/*",
    "https://*.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  }
}